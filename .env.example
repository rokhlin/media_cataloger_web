# =====================================================================
# MEDIA CATALOGER WEB - ENVIRONMENT CONFIGURATION (Machine A)
# =====================================================================

# Server Port
PORT=8000
NODE_ENV=production

# Remote Machine B Cataloger AI Engine URL
CATALOGER_API_URL=http://localhost:8001

# Application Paths
CONFIG_PATH=./data/config
MEDIA_INPUT=./media_input
MEDIA_OUTPUT=./media_output

# Optional explicit SQLite DB paths (default to inside MEDIA_OUTPUT)
# DB_PATH=./media_output/catalog_history.db
# FAMILY_TREE_DB_PATH=./media_output/family_tree.db
